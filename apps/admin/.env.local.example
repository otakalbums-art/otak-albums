# ==== Supabase (спільні значення, беруться з `supabase status` після supabase start) ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Тільки для серверних route handlers/edge-функцій. НІКОЛИ не потрапляє у клієнтський бандл.
SUPABASE_SERVICE_ROLE_KEY=

# ==== Client app ====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Admin app ====
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ==== Прийом фото з Wi-Fi камер (FTP, apps/admin/scripts/ftp-ingest.mjs) ====
# Будь-який довгий випадковий рядок — визначає FTP-логін/пароль кожного класу
# (детерміновано, нічого не зберігається в БД). Постав власний перед зйомкою.
FTP_INGEST_SECRET=
# За потреби змінити порт/passive-діапазон (мають бути відкриті у файрволі):
# FTP_PORT=2121
# FTP_PASV_MIN=2122
# FTP_PASV_MAX=2130
